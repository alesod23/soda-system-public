# Copy to .env (never commit it) and fill in what you use. Every value has a working default except the secrets.
# Existing environment variables always win over this file.

# ---- where state lives (ledgers, compiled skills, jsonl ledgers, hub state). Default: <repo>/data
SODA_HOME=./data
# where compiled skills are installed; set to ~/.claude/skills to make Claude Code load them as skills
# SODA_SKILLS_DIR=~/.claude/skills

# ---- the model that classifies feedback and notifications (the Claude Code CLI, non-interactive)
SODA_LLM_BIN=claude
SODA_LLM_MODEL=opus
# SODA_LLM_STUB=examples/llm-stub.json     # answer every model call from a file (tests, offline demos)

# ---- approval hub
HUB_HOST=127.0.0.1
HUB_PORT=4180
HUB_URL=http://127.0.0.1:4180
# Telegram: leave empty to run the hub without a phone (cards are printed to the hub's log instead)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- the brain (Postgres 16 + pgvector)
SODA_DB_DSN=postgresql://soda:change-me@127.0.0.1:5432/soda
# shared secret for remote callers of the brain door (loopback is exempt); generate with: openssl rand -hex 32
SODA_TOKEN=
# optional read-only token (GET routes, recall, match, rules, MCP)
SODA_TOKEN_RO=
BRAIN_HOST=127.0.0.1
BRAIN_PORT=4150
# markdown root indexed as memory/, system/, handoffs/ (default: the repo's examples/brain)
# BRAIN_REPO=./examples/brain
# BRAIN_SOURCES=memory=./notes/*.md,rule=./data/ledgers/*-CONTRACT.md
BRAIN_MODEL=intfloat/multilingual-e5-small
# optional: a folder of to-do markdown files (Tasks/{active,inbox,waiting,archive}/*.md) mirrored into todo.items
# TASKLAND=./my-tasks

# ---- time zone used for day-numbered cards and daily reports
SODA_TZ=UTC

# ---- simulation (sim/): optional Langfuse tracing; a no-op when unset or when the langfuse SDK is not installed
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# arm "brain": "door" asks a running brain instead of the local stand-in
# BRAIN_URL=http://127.0.0.1:4150
